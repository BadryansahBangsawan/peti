{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peti",
  "account_id": "affb450d746e53150028bb763b2f640c",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "peti.badry.engineer",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/callback", "/callback/*"]
  }
}
